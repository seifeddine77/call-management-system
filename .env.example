# ============================================
# DATABASE — PostgreSQL
# ============================================
POSTGRES_USER=callmgmt
POSTGRES_PASSWORD=callmgmt_secret_2024
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ============================================
# REDIS
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================
# RABBITMQ
# ============================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ============================================
# EUREKA
# ============================================
EUREKA_URL=http://eureka-server:8761/eureka

# ============================================
# JWT SECRETS (min 32 characters)
# ============================================
JWT_SECRET=your-access-token-secret-key-min-32-chars-change-me
JWT_REFRESH_SECRET=your-refresh-token-secret-key-min-32-chars-change-me

# ============================================
# LLM LOCAL (Gemma 4 via Docker Model Runner)
# ============================================
# Pas de cloud : le LLM tourne en local (souveraineté des données / RGPD).
# Ces valeurs sont déjà fixées dans docker-compose.yml ; ne rien mettre ici
# sauf si vous pointez vers un autre runtime local compatible OpenAI.
# OPENAI_API_KEY=docker-model-runner
# OPENAI_BASE_URL=http://host.docker.internal:12434/engines/llama.cpp/v1
# OPENAI_MODEL=ai/gemma4

# ============================================
# MAIL (SMTP)
# ============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ============================================
# FRONTEND
# ============================================
VITE_API_URL=http://localhost:8080
VITE_WS_URL=http://localhost:8083

# ============================================
# N8N
# ============================================
N8N_PASSWORD=changeme

# ============================================
# SONARQUBE (optional)
# ============================================
SONAR_TOKEN=your-sonar-token
SONAR_HOST_URL=https://sonarcloud.io

# ============================================
# DEPLOYMENT (optional)
# ============================================
STAGING_HOST=your.server.ip
