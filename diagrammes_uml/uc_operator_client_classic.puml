@startuml UC_Operator_Client_Classic
skinparam shadowing false
skinparam dpi 200
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor white
skinparam actorStyle stick

' Classic UML styling (white fill, thin black border)
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor     #000000
    ArrowColor      #000000
    FontColor       #000000
    FontSize        12
}
skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor     #000000
    FontColor       #000000
    FontSize        12
    FontStyle       bold
}
skinparam rectangle {
    BorderColor     #000000
    BorderThickness 1.5
    FontColor       #000000
    FontSize        14
    FontStyle       bold
    BackgroundColor #FFFFFF
}

left to right direction

actor "Opérateur" as Op
actor "Client"    as Cl

rectangle "Système AutoAssist (Opérateur & Client)" {
    
    ' Main Use Cases
    usecase "Créer un ticket" as UC_Create
    usecase "Gérer les tickets" as UC_Manage
    usecase "Consulter la file d'attente (Queue)" as UC_Queue
    usecase "Traiter un appel VoIP" as UC_CallFlow
    usecase "Statuer sur une décision" as UC_Decision
    usecase "Utiliser le chatbot WhatsApp" as UC_Chatbot
    
    ' Common included usecase on the right
    usecase "S'authentifier" as UC_Auth
    
    ' Inherited Use Cases for UC_Create
    usecase "Créer ticket par téléphone (CALL)" as UC_Create_Call
    usecase "Créer ticket par email (EMAIL)" as UC_Create_Email
    usecase "Créer ticket par formulaire (WEB)" as UC_Create_Web
    
    ' Inherited Use Cases for UC_Manage
    usecase "Consulter et filtrer les tickets" as UC_Manage_View
    usecase "Changer le statut du ticket" as UC_Manage_Status
    
    ' Included usecases for UC_CallFlow
    usecase "Enregistrer l'audio (Twilio)" as UC_CallFlow_Record
    usecase "Transcrire l'audio (Whisper STT)" as UC_CallFlow_Transcribe
    usecase "Analyser le texte (spaCy NLP)" as UC_CallFlow_Analyze
    
    ' Extending usecase for UC_Decision
    usecase "Générer courrier PDF (Letter)" as UC_Letter
    
    ' Generalisations (Inheritance)
    UC_Create_Call -|> UC_Create
    UC_Create_Email -|> UC_Create
    UC_Create_Web -|> UC_Create
    
    UC_Manage_View -|> UC_Manage
    UC_Manage_Status -|> UC_Manage
    
    ' Connections from Opérateur
    Op --> UC_Create
    Op --> UC_Manage
    Op --> UC_Queue
    Op --> UC_CallFlow
    Op --> UC_Decision
    Op --> UC_Chatbot
    
    ' Connections from Client
    Cl --> UC_Create_Web
    
    ' Includes pointing to S'authentifier
    UC_Create ..> UC_Auth : <<include>>
    UC_Manage ..> UC_Auth : <<include>>
    UC_Queue ..> UC_Auth : <<include>>
    UC_CallFlow ..> UC_Auth : <<include>>
    UC_Decision ..> UC_Auth : <<include>>
    UC_Chatbot ..> UC_Auth : <<include>>
    
    ' Call flow sub-inclusions
    UC_CallFlow ..> UC_CallFlow_Record : <<include>>
    UC_CallFlow_Record ..> UC_CallFlow_Transcribe : <<include>>
    UC_CallFlow_Transcribe ..> UC_CallFlow_Analyze : <<include>>
    
    ' Extend relation
    UC_Letter ..> UC_Decision : <<extend>>
}

@enduml
