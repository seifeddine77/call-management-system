@startuml UC_Supervisor_Classic
skinparam shadowing false
skinparam dpi 200
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor white
skinparam actorStyle stick

' Classic UML styling (white fill, thin black border)
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor     #000000
    ArrowColor      #000000
    FontColor       #000000
    FontSize        12
}
skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor     #000000
    FontColor       #000000
    FontSize        12
    FontStyle       bold
}
skinparam rectangle {
    BorderColor     #000000
    BorderThickness 1.5
    FontColor       #000000
    FontSize        14
    FontStyle       bold
    BackgroundColor #FFFFFF
}

left to right direction

actor "Superviseur" as Sup

rectangle "Système AutoAssist (Module de Supervision)" {
    
    ' Main Use Cases
    usecase "Configurer les règles d'assurance" as UC_Rules
    usecase "Tester les règles" as UC_Test
    usecase "Superviser les décisions" as UC_Decisions
    usecase "Consulter les KPIs d'agence" as UC_KPI
    usecase "Utiliser le chatbot WhatsApp" as UC_Chatbot
    
    ' Common included usecase on the far right
    usecase "S'authentifier" as UC_Auth
    
    ' Vertical layout alignment
    UC_Test -[hidden]right-> UC_Rules
    UC_Rules -[hidden]right-> UC_Decisions
    UC_Decisions -[hidden]right-> UC_KPI
    UC_KPI -[hidden]right-> UC_Chatbot
    
    ' Connections from Supervisor
    Sup --> UC_Rules
    Sup --> UC_Test
    Sup --> UC_Decisions
    Sup --> UC_KPI
    Sup --> UC_Chatbot
    
    ' Includes pointing to S'authentifier on the right
    UC_Rules ..> UC_Auth : <<include>>
    UC_Test ..> UC_Auth : <<include>>
    UC_Decisions ..> UC_Auth : <<include>>
    UC_KPI ..> UC_Auth : <<include>>
    UC_Chatbot ..> UC_Auth : <<include>>
    
    ' Internal includes
    UC_Test ..> UC_Rules : <<include>>
}

@enduml
