{
  "title": "AutoAssist — Docker Compose Status",
  "uid": "autoassist-docker-status",
  "version": 2,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "current": { "selected": true, "value": "Prometheus", "text": "Prometheus" },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "panels": [
    {
      "title": "🐳 DOCKER COMPOSE OVERVIEW",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "Running Containers",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 1 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "count(dockerstats_memory_usage_bytes{name=~\"callmgmt-.*\"})",
          "legendFormat": "Active Containers"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "green", "value": 14 }
            ]
          }
        }
      }
    },
    {
      "title": "Total CPU Usage (%)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 1 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "sum(dockerstats_cpu_usage_ratio{name=~\"callmgmt-.*\"})",
          "legendFormat": "CPU %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": { "mode": "continuous-GrYlRd" }
        }
      }
    },
    {
      "title": "Total Memory Usage",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 1 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "sum(dockerstats_memory_usage_bytes{name=~\"callmgmt-.*\"})",
          "legendFormat": "RAM"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "continuous-GrYlRd" }
        }
      }
    },
    {
      "title": "🚀 CONTAINERS CPU & MEMORY",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false
    },
    {
      "title": "Memory Usage per Container",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "dockerstats_memory_usage_bytes{name=~\"callmgmt-.*\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" }
        }
      },
      "options": { "orientation": "horizontal", "displayMode": "lcd" }
    },
    {
      "title": "CPU Usage per Container (%)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "dockerstats_cpu_usage_ratio{name=~\"callmgmt-.*\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "palette-classic" }
        }
      },
      "options": { "orientation": "horizontal", "displayMode": "lcd" }
    },
    {
      "title": "📈 RESOURCES HISTORICAL TRENDS",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "collapsed": false
    },
    {
      "title": "Microservices CPU Trend",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "dockerstats_cpu_usage_ratio{name=~\"callmgmt-(api-gateway|auth|ticket|decision|rules|ai|notification|analytics|organisation|eureka).*\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "lineWidth": 2, "fillOpacity": 5 }
        }
      }
    },
    {
      "title": "Microservices Memory Trend",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "dockerstats_memory_usage_bytes{name=~\"callmgmt-(api-gateway|auth|ticket|decision|rules|ai|notification|analytics|organisation|eureka).*\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 2, "fillOpacity": 5 }
        }
      }
    },
    {
      "title": "🔄 MEMORY PRESSURE",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "collapsed": false
    },
    {
      "title": "Memory Usage vs Limit per Container (%)",
      "type": "stat",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 25 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "dockerstats_memory_usage_ratio{name=~\"callmgmt-.*\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    }
  ]
}
