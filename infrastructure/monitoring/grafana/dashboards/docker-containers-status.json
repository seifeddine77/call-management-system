{
  "title": "AutoAssist — Docker Compose Status",
  "uid": "autoassist-docker-status",
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "value": "Prometheus",
          "text": "Prometheus"
        },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "panels": [
    {
      "title": "🐳 DOCKER COMPOSE OVERVIEW",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "Running Containers",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 1 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "count(container_last_seen{name=~\"callmgmt-.*\"})",
          "legendFormat": "Active Containers"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "green", "value": 14 }
            ]
          }
        }
      }
    },
    {
      "title": "Total CPU Usage (Cores)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 1 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{name=~\"callmgmt-.*\"}[5m]))",
          "legendFormat": "Cores"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": { "mode": "continuous-GrYlRd" }
        }
      }
    },
    {
      "title": "Total Memory Usage",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 1 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "sum(container_memory_usage_bytes{name=~\"callmgmt-.*\"})",
          "legendFormat": "RAM"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "continuous-GrYlRd" }
        }
      }
    },
    {
      "title": "🚀 CONTAINERS CPU & MEMORY LIMITS",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false
    },
    {
      "title": "Memory Usage per Container",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "container_memory_usage_bytes{name=~\"callmgmt-.*\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "lcd"
      }
    },
    {
      "title": "CPU Usage per Container (%)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{name=~\"callmgmt-.*\"}[5m]) * 100",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "lcd"
      }
    },
    {
      "title": "📈 RESOURCES HISTORICAL TRENDS",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "collapsed": false
    },
    {
      "title": "Microservices CPU Trend",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{name=~\"callmgmt-(api-gateway|auth-service|ticket-service|decision-service|rules-service|ai-service|notification-service|analytics-service|organisation-service|eureka-server).*\"}[5m]) * 100",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        }
      }
    },
    {
      "title": "Microservices Memory Trend",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "container_memory_usage_bytes{name=~\"callmgmt-(api-gateway|auth-service|ticket-service|decision-service|rules-service|ai-service|notification-service|analytics-service|organisation-service|eureka-server).*\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        }
      }
    },
    {
      "title": "🔄 UPTIME & STABILITY",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "collapsed": false
    },
    {
      "title": "Container Uptime (Time since last start)",
      "type": "stat",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 25 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "time() - container_start_time_seconds{name=~\"callmgmt-.*\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 300 },
              { "color": "green", "value": 1800 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    }
  ]
}
