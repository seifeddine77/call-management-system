{
  "title": "AutoAssist — Jenkins Pipeline",
  "uid": "autoassist-jenkins",
  "version": 1,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "title": "Build Duration (last 20)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 0 },
      "targets": [{ "expr": "jenkins_job_duration_seconds", "legendFormat": "{{jobName}}" }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2, "drawStyle": "bars", "fillOpacity": 50 } } }
    },
    {
      "title": "Build Success Rate",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [{ "expr": "jenkins_job_last_build_result_ordinal == 0", "legendFormat": "Success" }],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "green", "value": 0.9 }] } } }
    },
    {
      "title": "Jenkins Queue Length",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 8 },
      "targets": [{ "expr": "jenkins_queue_size_value", "legendFormat": "Queued" }]
    },
    {
      "title": "Jenkins Executors — Busy",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 8 },
      "targets": [{ "expr": "jenkins_executor_in_use_value", "legendFormat": "Busy" }]
    },
    {
      "title": "Jenkins Nodes Online",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 8 },
      "targets": [{ "expr": "jenkins_node_online_value", "legendFormat": "Online" }]
    },
    {
      "title": "Pipeline Stage Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [{ "expr": "jenkins_job_stage_duration_seconds", "legendFormat": "{{stageName}}" }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2, "drawStyle": "bars", "fillOpacity": 30 } } }
    }
  ],
  "schemaVersion": 39
}
