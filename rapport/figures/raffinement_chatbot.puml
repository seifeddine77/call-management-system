@startuml raffinement_chatbot
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
}

actor "Operateur /\nSuperviseur" as op
actor "Chatbot" as chatbot

rectangle "AutoAssist" {
  usecase "S'authentifier" as auth
  usecase "Interroger le chatbot\nWhatsApp" as UC1
  usecase "Envoyer un message\ntexte" as UC2
  usecase "Envoyer un message\nvocal" as UC3
  usecase "Envoyer une commande\nrapide" as UC4
  usecase "Transcrire l'audio\n(Whisper)" as UC5
  usecase "Recherche hybride\nChromaDB" as UC6
  usecase "Generer reponse\n(Gemma 4)" as UC7
  usecase "Executer requete\nAPI directe" as UC8
}

op --> UC1
UC1 --> chatbot

UC1 ..> auth : <<include>>
UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>

UC3 ..> UC5 : <<include>>
UC5 ..> UC6 : <<include>>
UC2 ..> UC6 : <<include>>
UC6 ..> UC7 : <<include>>
UC4 ..> UC8 : <<include>>

@enduml
