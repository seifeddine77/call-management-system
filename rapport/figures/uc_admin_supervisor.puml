@startuml uc_admin_supervisor
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
}

actor "Administrateur" as admin
actor "Superviseur" as sup

rectangle "AutoAssist" {
  usecase "S'authentifier" as auth

  usecase "Gerer les utilisateurs" as UC1
  usecase "Creer un compte" as UC1a
  usecase "Modifier un compte" as UC1b
  usecase "Attribuer un role\n(RBAC)" as UC1c

  usecase "Gerer les agences" as UC2
  usecase "Affecter operateurs\naux agences" as UC2a

  usecase "Configurer les regles\nd'assurance" as UC3
  usecase "Tester une regle" as UC3a
  usecase "Consulter l'historique\ndes versions" as UC3b

  usecase "Consulter les KPIs" as UC4
  usecase "Exporter les\ndonnees (CSV)" as UC4a

  usecase "Superviser les tickets" as UC5
  usecase "Interroger le chatbot" as UC6
}

admin --> UC1
admin --> UC2
admin --> UC5

sup --> UC3
sup --> UC4
sup --> UC6

UC1 ..> auth : <<include>>
UC2 ..> auth : <<include>>
UC3 ..> auth : <<include>>
UC4 ..> auth : <<include>>
UC5 ..> auth : <<include>>
UC6 ..> auth : <<include>>

UC1 ..> UC1a : <<include>>
UC1 ..> UC1b : <<include>>
UC1a ..> UC1c : <<include>>
UC2 ..> UC2a : <<include>>

UC3 ..> UC3a : <<extend>>
UC3 ..> UC3b : <<extend>>
UC4 ..> UC4a : <<extend>>

@enduml
