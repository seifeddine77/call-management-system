@startuml uc_operateur
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
}

actor "Operateur" as op
actor "Chatbot" as chatbot

rectangle "AutoAssist" {
  usecase "S'authentifier" as auth

  usecase "Gerer les tickets" as UC1
  usecase "Creer un ticket\n(appel / email / web)" as UC1a
  usecase "Consulter la liste\ndes tickets" as UC1b

  usecase "Traiter un ticket\navec aide IA" as UC2
  usecase "Uploader un\nenregistrement audio" as UC2a
  usecase "Lancer la transcription\n(Whisper)" as UC2b
  usecase "Lancer l'analyse NLP\n(spaCy)" as UC2c
  usecase "Lancer l'analyse\ndecisionnelle" as UC2d
  usecase "Generer un\ncourrier PDF" as UC2e

  usecase "Interroger le chatbot\nWhatsApp" as UC3

  usecase "Consulter les\nnotifications" as UC4

  usecase "Gerer les informations\npersonnelles" as UC5
}

op --> UC1
op --> UC2
op --> UC3
op --> UC4
op --> UC5

UC3 --> chatbot

UC1 ..> auth : <<include>>
UC2 ..> auth : <<include>>
UC3 ..> auth : <<include>>

UC1 ..> UC1a : <<include>>
UC1 ..> UC1b : <<include>>

UC2 ..> UC2a : <<include>>
UC2a ..> UC2b : <<include>>
UC2b ..> UC2c : <<include>>
UC2 ..> UC2d : <<include>>
UC2d ..> UC2e : <<extend>>

@enduml
