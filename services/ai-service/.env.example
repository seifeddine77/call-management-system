# ─────────────────────────────────────────────────
# AI Service — Environment Variables
# Copy this file to .env for local development:
#   cp .env.example .env
# ─────────────────────────────────────────────────

# Database (PostgreSQL)
DATABASE_URL=postgresql://callmgmt:callmgmt_secret_2024@localhost:5432/ai_db

# Audio storage
AUDIO_STORAGE_PATH=./audio_storage
MAX_AUDIO_SIZE_MB=50
WHISPER_MODEL=small

# Eureka
EUREKA_SERVER=http://localhost:8761/eureka
APP_NAME=ai-service
INSTANCE_PORT=8000

# LLM (Gemma 4)
LLM_BASE_URL=http://host.docker.internal:12434/engines/llama.cpp/v1
LLM_API_KEY=docker-model-runner
LLM_MODEL=ai/gemma4
LLM_TIMEOUT=180
